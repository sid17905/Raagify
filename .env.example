# Recommendation: copy to .env, choose private values, and keep .env untracked.
MYSQL_DATABASE=raagify
MYSQL_USER=raagify
MYSQL_PASSWORD=replace-with-private-database-password
MYSQL_ROOT_PASSWORD=replace-with-private-root-password
DB_URL=jdbc:mysql://127.0.0.1:3306/raagify?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=raagify
DB_PASSWORD=replace-with-private-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-private-admin-password
ADMIN_NAME=Raagify Admin
SERVER_PORT=8080
AUDIO_STORAGE_PATH=./data/audio
COVER_STORAGE_PATH=./data/covers
AUDIO_MAX_BYTES=26214400
COVER_MAX_BYTES=5242880
ML_BASE_URL=http://127.0.0.1:8000
ML_CONNECT_TIMEOUT_MS=750
ML_READ_TIMEOUT_MS=15000
DEV_API_TARGET=http://127.0.0.1:8080
# Optional trusted sklearn pipeline + matching .json manifest; leave empty otherwise.
GENRE_MODEL_PATH=
